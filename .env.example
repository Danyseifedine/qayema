APP_NAME=Qayema
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false. Debug mode leaks stack
# traces (env vars, DB credentials); APP_ENV must not be "local" in production
# (Telescope only loads in local). These local defaults are for development only.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qayema
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Minutes of inactivity before the session (and its CSRF token) expires. The
# dashboard SPA rides this session, so keep it long (525600 = 1 year) to avoid
# owners being logged out / hit with 419s after idling.
SESSION_LIFETIME=525600
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leading-dot root domain so the session cookie is shared with the dashboard
# subdomain SPA (e.g. SESSION_DOMAIN=.qayema.com). Leave null for a single host.
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS (keep true in production)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Dashboard SPA (Sanctum cookie-based auth) ---
# Hosts allowed to make stateful (cookie-authenticated) requests (no scheme/port-less host).
SANCTUM_STATEFUL_DOMAINS=dashboard.qayema.com
# Cross-origin browser origins permitted to send credentialed requests (full origin, comma-separated).
CORS_ALLOWED_ORIGINS=https://dashboard.qayema.com
# Absolute URL the onboarding wizard redirects to once setup completes.
DASHBOARD_URL=https://dashboard.qayema.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# --- Mail (Resend in production, log locally) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
# Where the public contact form's messages are delivered. Required.
CONTACT_RECIPIENT_EMAIL=

# --- Google sign-in (Socialite) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- Media storage: Cloudflare R2 (the `r2` disk in config/filesystems.php) ---
# `public` keeps uploads on this server; set r2 once the bucket below is ready.
MEDIA_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
# The account's S3 API: https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# The bucket's public domain, which guests load the images from.
R2_PUBLIC_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

# Trusted reverse proxies (comma-separated IPs/CIDRs, or * to trust all). Leave empty when not behind a proxy.
TRUSTED_PROXIES=

# IPs AbuseGuard never rate-bans or blocks (comma-separated), e.g. office / monitoring egress IPs.
SECURITY_TRUSTED_IPS=

# Google reCAPTCHA v3. Leave both empty to disable captcha entirely (graceful no-op).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Optional social metadata for the public portal's SEO tags.
TWITTER_USERNAME=
FACEBOOK_APP_ID=
# Public support address shown on the contact and legal pages.
CONTACT_PUBLIC_EMAIL=
