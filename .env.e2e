# End-to-end test environment (qayema-dashboard/e2e, Playwright).
# Loaded instead of .env when APP_ENV=e2e. No secrets: a throwaway key, a
# SQLite file of its own, logged mail, local uploads. Never point this at
# the MySQL database.
APP_NAME=Qayema
APP_ENV=e2e
APP_KEY=base64:0rdLC7GjMVf/BLPNOlcmw5hgoz+kSEccAwSNcu1GV9Q=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DASHBOARD_URL=http://127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5174

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=wal

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# The array store lives for one request under the built-in server, which
# turns every rate limiter off here; PHPUnit covers them.
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=4

FILESYSTEM_DISK=local
MEDIA_DISK=e2e

SECURITY_TRUSTED_IPS=127.0.0.1,::1
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TELESCOPE_ENABLED=false
